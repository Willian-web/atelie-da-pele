PORT=3000
# Backend URL if needed
# API_BASE_URL=http://localhost:3000

# Admin (MVP): senha nunca vai no frontend; só o token retornado por POST /admin/login
ADMIN_PASSWORD=defina_uma_senha_forte_aqui
# Recomendado em produção (16+ caracteres aleatórios): invalida sessões ao rotacionar, sem mudar a senha
# ADMIN_SESSION_SECRET=
# Opcional: TTL do token em segundos (padrão 86400 = 24h; mínimo 300, máximo 2592000)
# ADMIN_SESSION_TTL_SECONDS=86400

# E-mail Notifications (Resend API HTTPS)
RESEND_API_KEY=re_123456789
NOTIFICATION_EMAIL=seu-email-que-recebera-os-avisos@gmail.com
FROM_EMAIL=onboarding@resend.dev

# WhatsApp da profissional (links wa.me no app): somente dígitos, com DDI — ex.: 5541991234567
ADMIN_WHATSAPP=

# InfinitePay Configurations
INFINITEPAY_HANDLE=sua_tag_infinitepay
# Não referenciado no código atual — mantido só como lembrete se a API passar a exigir chave separada do handle.
# INFINITEPAY_API_KEY=
INFINITEPAY_SUCCESS_URL=https://seusite.com/sucesso
INFINITEPAY_WEBHOOK_URL=https://seusite.com/webhook/infinitepay
# Opcional: se definido, o POST /webhook/infinitepay exige o mesmo valor em um destes headers:
# x-webhook-secret, x-infinitepay-webhook-secret ou x-atelie-webhook-secret (configure no InfinitePay ao suportar headers customizados).
# Se vazio, o webhook continua aceito (compatibilidade) e o servidor registra aviso em log.
# INFINITEPAY_WEBHOOK_SECRET=
