# Porta do Servidor
PORT=3000

# Provedor Ativo: Escolha entre 'twilio' ou 'meta'
WHATSAPP_PROVIDER=twilio

# ==========================================
# CONFIGURAÇÃO TWILIO (Opção 1)
# ==========================================
TWILIO_ACCOUNT_SID=sua_auth_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
# Número fornecido pela API / Sandbox (ex: +14155238886)
TWILIO_FROM_NUMBER=+14155238886

# ==========================================
# CONFIGURAÇÃO META / WHATSAPP CLOUD API (Opção 2)
# ==========================================
META_ACCESS_TOKEN=seu_token_de_acesso_temporario_ou_permanente_aqui
META_PHONE_NUMBER_ID=id_do_seu_numero_aqui
